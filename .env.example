# ==============================================================================
# SCHOOL PAY MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit real secret keys to GitHub!
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV="development"

# App public URL (used for CORS, callback URLs, and PWA manifest links)
APP_URL="http://localhost:3000"
VITE_PORTFOLIO_URL="https://arinze-web-studio.netlify.app/"

# Cloudflare Free-Tier Settings (For Cloudflare Pages / Workers deployment)
# CLOUDFLARE_D1_DATABASE_ID: Run 'wrangler d1 create schoolpay-db' to obtain
CLOUDFLARE_D1_DATABASE_ID="your-d1-database-uuid"

# Cloudflare Turnstile Bot Protection (Optional for Step 1, free tier on Cloudflare dashboard)
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Master Security Secrets (Set via: wrangler secret put JWT_SECRET)
JWT_SECRET="generate-a-secure-random-64-character-hex-string-for-jwt"

# Production Database (Neon Serverless PostgreSQL)
# Example: postgres://username:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Bachs.io Payment Gateway Integration (SaaS Subscriptions & School Collections)
BACHS_API_KEY=""
BACHS_WEBHOOK_SECRET=""
BACHS_API_URL="https://api.bachs.io"

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"

